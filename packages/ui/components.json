{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "base-nova",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "styles/tokens.css",
    "baseColor": "zinc",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "aliases": {
    "components": "@metanicator/ui/components",
    "ui": "@metanicator/ui/components/ui",
    "hooks": "@metanicator/ui/hooks",
    "lib": "@metanicator/ui/lib",
    "utils": "@metanicator/ui/lib/utils"
  },
  "registries": {
    "@reui": {
      "url": "https://reui.io/r/base-nova/{name}.json",
      "headers": {
        "Authorization": "Bearer ${REUI_LICENSE_KEY}"
      }
    }
  }
}
