# Mobile production env — committed so external users can build a personal
# iPhone copy of Metanicator against the same backend as metanicator.ai on web.
# Loaded by the `*:prod` scripts via dotenv-cli (see package.json).
EXPO_PUBLIC_API_URL=https://api.metanicator.ai
EXPO_PUBLIC_WEB_URL=https://metanicator.ai
